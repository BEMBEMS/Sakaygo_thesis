{
  "name": "tricycle-matching-thesis",
  "version": "0.1.0",
  "private": true,
  "description": "Thesis-based passenger-tricycle matching system",
  "scripts": {
    "api:install": "npm install --prefix server",
    "api:dev": "npm --prefix server run dev",
    "api:build": "npm --prefix server run build",
    "api:lint": "npm --prefix server run lint",
    "api:typecheck": "npm --prefix server run typecheck",
    "api:test": "npm --prefix server test",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:migrate:test": "npm --prefix server run db:migrate:test",
    "admin:create": "npm --prefix server run admin:create",
    "matcher:dev": "python -m uvicorn app.main:app --app-dir services/matching --reload --port 8000",
    "matcher:test": "python -m pytest services/matching/tests",
    "mobile:get": "flutter pub get --directory apps/mobile",
    "mobile:analyze": "flutter analyze apps/mobile",
    "mobile:test": "cd apps/mobile && flutter test"
  }
}
